<?xml version="1.0" encoding="UTF-8"?>
<deploy xmlns="http://www.apache.org/ode/schemas/dd/2007/03">
    <process name="DroneFineProcess"
             xmlns:tns="http://www.example.com/bpel">
        <active>true</active>
        <retired>false</retired>
        <process-events generate="all"/>

        <!-- Этот порт принимает вызовы клиента -->
        <provide partnerLink="client">
            <service name="tns:DroneFineProcessService"
                     port="DroneFineProcessPort"/>
        </provide>

        <!-- Этот порт вызывает SOAP-сервис дронов -->
        <invoke partnerLink="droneService"/>
    </process>
</deploy>
