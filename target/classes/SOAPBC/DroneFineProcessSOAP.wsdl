<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:tns="http://www.example.com/bpel"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:plnk="http://schemas.xmlsoap.org/ws/2003/05/partner-link/"
             targetNamespace="http://www.example.com/bpel"
             name="DroneFineProcessSOAP">

    <!-- Импорт типов из BPEL процесса -->
    <types>
        <xsd:schema targetNamespace="http://www.example.com/bpel"
                    xmlns:tns="http://www.example.com/bpel"
                    xmlns:dr="http://www.example.com/drone">
            <xsd:import namespace="http://www.example.com/drone"
                       schemaLocation="../DroneFineProcess/drone_target.xsd"/>
            
            <xsd:element name="DroneFineRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="droneId" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            
            <xsd:element name="DroneFineResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="droneInfo" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            
            <xsd:element name="ServiceFault">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="errorCode" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            
            <xsd:element name="ValidationFault">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="field" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </types>

    <!-- Сообщения -->
    <message name="DroneFineRequestMessage">
        <part name="parameters" element="tns:DroneFineRequest"/>
    </message>
    
    <message name="DroneFineResponseMessage">
        <part name="parameters" element="tns:DroneFineResponse"/>
    </message>
    
    <message name="ServiceFaultMessage">
        <part name="fault" element="tns:ServiceFault"/>
    </message>
    
    <message name="ValidationFaultMessage">
        <part name="fault" element="tns:ValidationFault"/>
    </message>

    <!-- Тип порта -->
    <portType name="DroneFinePT">
        <operation name="processDroneData">
            <input message="tns:DroneFineRequestMessage"/>
            <output message="tns:DroneFineResponseMessage"/>
            <fault name="ServiceFault" message="tns:ServiceFaultMessage"/>
            <fault name="ValidationFault" message="tns:ValidationFaultMessage"/>
        </operation>
    </portType>

    <!-- Привязка SOAP -->
    <binding name="DroneFineSOAPBinding" type="tns:DroneFinePT">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="processDroneData">
            <soap:operation soapAction="http://www.example.com/bpel/processDroneData"/>
            <input>
                <soap:body use="literal"/>
            </input>
            <output>
                <soap:body use="literal"/>
            </output>
            <fault name="ServiceFault">
                <soap:fault name="ServiceFault" use="literal"/>
            </fault>
            <fault name="ValidationFault">
                <soap:fault name="ValidationFault" use="literal"/>
            </fault>
        </operation>
    </binding>

    <!-- Сервис -->
    <service name="DroneFineProcessSOAPService">
        <port name="DroneFineProcessSOAPPort" binding="tns:DroneFineSOAPBinding">
            <soap:address location="http://localhost:8080/soap/DroneFineProcess"/>
        </port>
    </service>

</definitions>

