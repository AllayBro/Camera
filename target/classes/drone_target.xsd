<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.example.com/drone"
           xmlns="http://www.example.com/drone"
           elementFormDefault="qualified">

    <xs:element name="DroneTarget">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="Drone" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Model" type="xs:string"/>
                            <xs:element name="Status" type="xs:string"/>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:ID" use="required"/>
                        <xs:attribute name="model" type="xs:string" use="required"/>
                        <xs:attribute name="status" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Target" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Name" type="xs:string"/>
                            <xs:element name="Type" type="xs:string"/>
                            <xs:element name="Coordinates">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Latitude" type="xs:decimal"/>
                                        <xs:element name="Longitude" type="xs:decimal"/>
                                        <xs:element name="Altitude" type="xs:decimal"/>
                                    </xs:sequence>
                                    <xs:attribute name="precision" type="xs:string" use="optional"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:ID" use="required"/>
                        <xs:attribute name="name" type="xs:string" use="required"/>
                        <xs:attribute name="type" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Photo" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="DroneID" type="xs:IDREF"/>
                            <xs:element name="TargetID" type="xs:IDREF"/>
                            <xs:element name="DateTime" type="xs:dateTime"/>
                            <xs:element name="FilePath" type="xs:string"/>
                            <xs:element name="PhotoMetadata">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Resolution" type="xs:string"/>
                                        <xs:element name="FileSize" type="xs:string"/>
                                        <xs:element name="Format" type="xs:string"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="id" type="xs:ID" use="required"/>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
